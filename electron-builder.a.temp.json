{
  "appId": "com.smartschoolai.shortvideo.a",
  "productName": "ShortVideo A",
  "directories": {
    "output": "dist-release/a"
  },
  "publish": [
    {
      "provider": "generic",
      "url": "https://download.shortvideo.ca/website/",
      "updaterCacheDirName": "shortvideo/update-a"
    }
  ],
  "protocols": [
    {
      "name": "ShortVideo A Protocol",
      "schemes": [
        "shortvideo-a",
        "shortvideo"
      ]
    }
  ],
  "files": [
    "dist-electron/**/*",
    "build/**/*",
    ".env.desktop",
    "!**/.env",
    "!**/.env.local",
    "!**/.env.*.local",
    "!**/.env.production",
    "!**/.env.development",
    "!**/*.pem",
    "!**/*.key"
  ],
  "asarUnpack": [
    "**/node_modules/@remotion/**/*",
    "**/node_modules/@esbuild/**/*",
    "**/node_modules/dotenv/**/*",
    "**/node_modules/react/**/*",
    "**/node_modules/react-dom/**/*",
    "build/remotion-bundle/**/*"
  ],
  "extraMetadata": {
    "channel": "A",
    "appId": "com.smartschoolai.shortvideo.a",
    "productName": "ShortVideo A"
  },
  "mac": {
    "icon": "build/icon-a.png",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.video"
  },
  "win": {
    "icon": "build/icon-a.png",
    "artifactName": "ShortVideo-A-Setup-${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "ShortVideo A"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "differentialPackage": true,
    "shortcutName": "ShortVideo A",
    "uninstallDisplayName": "ShortVideo A"
  },
  "linux": {
    "icon": "build/icon-a.png",
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "rpm",
        "arch": [
          "x64"
        ]
      }
    ],
    "maintainer": "ShortVideo Team <support@shortvideo.ca>",
    "category": "Video",
    "mimeTypes": [
      "x-scheme-handler/shortvideo"
    ],
    "syncDesktopName": true
  },
  "disableSanityCheckAsar": true
}